---
import type { CollectionEntry } from "astro:content";
import Link from "@components/Link.astro";

type Props = {
  publication: CollectionEntry<"publications">;
};

const { publication } = Astro.props as Props;

interface AffiliatedLink {
  name: string;
  url: string;
}

const parseAffiliatedLinks = (links: string): AffiliatedLink[] => links
  .split(", ")
  .map((link: string) => {
    const [name, url] = link.split(": ");
    return { name, url };
  })
  .filter((link): link is AffiliatedLink => Boolean(link.name && link.url));

let websitePath: string;
let isLocal = false;
if (publication.data.website !== "local") {
  websitePath = publication.data.website;
  isLocal = false;
} else {
  websitePath = `/publications/${publication.id}`;
  isLocal = true;
}

const externalAffiliatedLinks = parseAffiliatedLinks(publication.data.externalAffiliatedLinks);
const localAffiliatedLinks = parseAffiliatedLinks(publication.data.localAffiliatedLinks);

let authors: string;
if (publication.data.trim_names == true) {
  authors = publication.data.authors
    .split(", ")
    .map((author: string) => {
      const nameParts = author.split(" ");
      const lastName = nameParts.pop();
      const initials = nameParts.map((part: string) => part.charAt(0) + ".").join(" ");
      return `${initials} ${lastName}`;
    })
    .join(", ");
} else {
  authors = publication.data.authors;
}

if (publication.data.etal === true) {
  authors = `${authors}, et al.`;
}
---

<div class="border-t border-[var(--border-soft)] py-3 transition-[border-color,background-color] duration-200 ease-out hover:border-[var(--border)]">
  <div class="flex flex-col justify-center">
    <Link href={websitePath} class="block leading-6" external={isLocal !== true}>
      {publication.data.title}
    </Link>

    <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--muted)]">
      {authors}
    </div>

    <div class="mt-1 text-sm leading-5 text-[var(--muted)]">
      {publication.data.summary}
    </div>

    <div class="mt-0.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[var(--muted)]">
      @ {publication.data.confShort} · {publication.data.date.getFullYear()}
      <span class="text-[var(--muted)] text-sm" aria-hidden="true">|</span>

      {externalAffiliatedLinks && externalAffiliatedLinks.length > 0 && (
        <ul class="flex flex-wrap gap-x-3 gap-y-1">
          {externalAffiliatedLinks.map((link: { name: string; url: string }) => (
            <li>
              <Link href={link.url} external>
                {link.name}
              </Link>
            </li>
          ))}
        </ul>
      )}

      {localAffiliatedLinks && localAffiliatedLinks.length > 0 && (
        <ul class="flex flex-wrap gap-x-3 gap-y-1">
          {localAffiliatedLinks.map((link: { name: string; url: string }) => (
            <li>
              <Link href={`/publications/${publication.id}/${link.url}`} external>
                {link.name}
              </Link>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</div>
