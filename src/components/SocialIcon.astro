---
import { mergeClassNames } from '../utils.ts';

export interface Props {
  URL: string;
  icon: string;
  icon_size: string;
}

const { URL, icon, icon_size } = Astro.props;

const iconPaths: Record<string, string[]> = {
  github: [
    "M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.41 7.86 10.94.58.11.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.16 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.35.78 1.05.78 2.12v3.15c0 .31.21.68.8.56A10.99 10.99 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z",
  ],
  linkedin: [
    "M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.95v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.55V9h3.57v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z",
  ],
  "mortarboard-fill": [
    "M12 3 1 9l11 6 9-4.91V17h2V9L12 3Zm0 8.74 6.76-3.69L12 4.36 5.24 8.05 12 11.74Zm-5 1.18v3.63c0 1.66 2.24 3 5 3s5-1.34 5-3v-3.63l-5 2.73-5-2.73Z",
  ],
  "twitter-x": [
    "M18.9 2h3.68l-8.04 9.19L24 22h-7.4l-5.8-7.58L4.17 22H.49l8.6-9.83L0 2h7.59l5.24 6.93L18.9 2Zm-1.29 18.1h2.04L6.48 3.8H4.29L17.61 20.1Z",
  ],
  "envelope-fill": [
    "M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13Zm2.5-.5a.5.5 0 0 0-.31.89l7.5 5.86c.18.14.44.14.62 0l7.5-5.86A.5.5 0 0 0 19.5 5h-15Zm15.5 3.05-6.46 5.05a2.5 2.5 0 0 1-3.08 0L4 8.05V18.5c0 .28.22.5.5.5h15a.5.5 0 0 0 .5-.5V8.05Z",
  ],
};

const iconLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  "mortarboard-fill": "Google Scholar",
  "twitter-x": "X",
  "envelope-fill": "Email",
};

const paths = iconPaths[icon] ?? iconPaths.github;
const label = iconLabels[icon] ?? "Social link";
const rel = URL.startsWith("mailto:") ? undefined : "noreferrer";
---

<a
  href={URL}
  target={'_blank'}
  rel={rel}
  aria-label={label}
  class={ mergeClassNames(
    `inline-flex ${icon_size}`,
    'social-link',
    'items-center justify-center',
    'transition-colors duration-100 ease-out',
    'align-middle',
  )}
>
  <svg class="h-[1em] w-[1em]" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    {paths.map((path) => <path d={path} />)}
  </svg>
</a>

<style>
  :global(.social-link) {
    color: var(--text);
  }
  :global(.social-link:hover),
  :global(.social-link:focus-visible) {
    color: var(--link);
  }
</style>
