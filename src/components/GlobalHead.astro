---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mátyás Vincze",
  description = "PhD researcher at the University of Trento and Fondazione Bruno Kessler, and visiting PhD researcher at MIT, working on LLM post-training, reinforcement learning, and multi-agent systems.",
} = Astro.props;

const pageTitle = title === "Mátyás Vincze" ? title : `${title} · Mátyás Vincze`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://vinczematyas.github.io/#person",
  name: "Mátyás Vincze",
  url: "https://vinczematyas.github.io/",
  jobTitle: "PhD Researcher",
  affiliation: [
    {
      "@type": "Organization",
      name: "University of Trento",
      url: "https://www.unitn.it/en",
    },
    {
      "@type": "Organization",
      name: "Fondazione Bruno Kessler",
      url: "https://www.fbk.eu/en/",
    },
    {
      "@type": "Organization",
      name: "Massachusetts Institute of Technology",
      url: "https://www.mit.edu/",
    },
  ],
  sameAs: [
    "https://github.com/vinczematyas",
    "https://www.linkedin.com/in/matyas-vincze/",
    "https://scholar.google.com/citations?user=I8vSMFEAAAAJ",
    "https://x.com/vinczematyas_",
  ],
};
---

<!-- Global Metadata -->
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width, initial-scale=1.0' />
<title>{pageTitle}</title>
<meta name='description' content={description} />
<meta name='author' content='Mátyás Vincze' />
<link rel='canonical' href={canonicalUrl} />
<meta property='og:type' content='website' />
<meta property='og:title' content={pageTitle} />
<meta property='og:description' content={description} />
<meta property='og:url' content={canonicalUrl} />
<meta name='twitter:card' content='summary' />
<meta name='twitter:title' content={pageTitle} />
<meta name='twitter:description' content={description} />
<script is:inline type='application/ld+json' set:html={JSON.stringify(personStructuredData)} />
<link rel='preload' href='/fonts/atkinson-hyperlegible-latin-400-normal.woff2' as='font' type='font/woff2' crossorigin />
<link rel='preload' href='/fonts/lythmono-regular-subset.woff2' as='font' type='font/woff2' crossorigin />
<link rel='icon' href='/favicon.ico?v=mv1' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png?v=mv1' />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png?v=mv1' />
<link data-theme-favicon rel='icon' type='image/svg+xml' sizes='any' href='/favicon.svg?v=mv1' />
<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png?v=mv1' />
<meta data-theme-color name='theme-color' content='#1f1f28' />
<script is:inline>
  (() => {
    const root = document.documentElement;
    const favicon = document.querySelector("link[data-theme-favicon]");
    const themeColor = document.querySelector("meta[data-theme-color]");
    const themeAssets = {
      light: {
        color: "#e8ebf1",
        favicon: "/favicon-light.svg?v=mv1",
      },
      dark: {
        color: "#1f1f28",
        favicon: "/favicon-dark.svg?v=mv1",
      },
    };

    const syncThemeAssets = () => {
      const theme = root.classList.contains("theme-light") ? "light" : "dark";
      const assets = themeAssets[theme];
      favicon?.setAttribute("href", assets.favicon);
      themeColor?.setAttribute("content", assets.color);
    };

    syncThemeAssets();
    new MutationObserver(syncThemeAssets).observe(root, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>
<meta name='generator' content={Astro.generator} />
